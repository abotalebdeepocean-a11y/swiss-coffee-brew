# ============================================
# ROVENTO Coffee — Environment Variables Template
# ============================================
# Copy this file to .env and fill in YOUR actual values
# The .env file is in .gitignore and should NEVER be committed
# ============================================

# ============================================
# 1. CONVEX BACKEND
# ============================================
# How to get:
# 1. Run: npx convex dev
# 2. It will show you the deployment URL
# 3. Copy it here
#
# Example: https://cool-deer-123.convex.cloud
VITE_CONVEX_URL=https://your-deployment-id.convex.cloud

# Your Convex deployment ID (shown in dashboard)
# Example: prod_cool-deer-123
CONVEX_DEPLOYMENT=prod_your-deployment-id

# Local development URL (change to your live domain in production)
CONVEX_SITE_URL=http://localhost:5173

# ============================================
# 2. FREEBUFF EMAIL SERVICE
# ============================================
# CRITICAL: This key authenticates email delivery
#
# How to get:
# 1. Log in to https://freebuff.com
# 2. Go to Settings → API Keys
# 3. Create/copy your API key
# 4. Paste it below
#
# ⚠️ SECURITY: This key is currently EXPOSED in git history!
# Action Required:
# 1. Revoke the old key in FreeBuff
# 2. Create a new key
# 3. Use the new key here
#
# Format: fb_email_[random-chars]
VITE_FREEBUFF_API_KEY=fb_email_your_api_key_here

# ============================================
# 3. VLY AI INTEGRATIONS (Optional - Dev only)
# ============================================
# For VLY AI development features
# Get from: https://app.vly.sh/settings
#
# Optional - only needed if using VLY features
VLY_INTEGRATION_KEY=vly_your_integration_key_here

# Display name for your app in VLY
VLY_APP_NAME=ROVENTO Coffee

# ============================================
# 4. APP CONFIGURATION
# ============================================
# WhatsApp business number for customer support
# Format: Country code + number without + or leading zeros
# Example: 201033012381 (Egypt: +20 is 201)
VITE_WHATSAPP_NUMBER=201033012381

# ============================================
# 5. ENVIRONMENT DETECTION
# ============================================
# Set to 'development' for local work
# Set to 'production' for live deployments
NODE_ENV=development
