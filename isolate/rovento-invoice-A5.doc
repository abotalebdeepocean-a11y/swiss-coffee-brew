<html xmlns:o="urn:schemas-microsoft-com:office:office"
      xmlns:w="urn:schemas-microsoft-com:office:word"
      xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!--[if gte mso 9]>
<xml>
  <w:WordDocument>
    <w:View>Print</w:View>
    <w:Zoom>100</w:Zoom>
    <w:DoNotOptimizeForBrowser/>
  </w:WordDocument>
</xml>
<![endif]-->
<title>ROVENTO - Sales Invoice</title>
<style>
  /* Page: A5 portrait */
  @page {
    size: 148mm 210mm;
    margin: 0;
  }
  @page Section1 {
    mso-page-orientation: portrait;
    size: 5590twips 7937twips; /* 148mm x 210mm */
    margin: 0;
  }
  div.Section1 {
    page: Section1;
  }

  body {
    font-family: 'Cairo', 'Tahoma', 'Arial', sans-serif;
    font-size: 10pt;
    color: #1a1612;
    direction: rtl;
    background: transparent;
    margin: 0;
    padding: 0;
  }

  table {
    border-collapse: collapse;
    width: 100%;
  }
  td, th {
    vertical-align: middle;
    padding: 3px 4px;
  }

  /* Header */
  .inv-header {
    background-color: #1a1410;
    color: #f5f0e8;
    padding: 10px 14px;
  }
  .logo-box {
    width: 40px; height: 40px;
    background-color: #d4af37;
    color: #1a1410;
    font-size: 20pt;
    font-weight: bold;
    text-align: center;
    vertical-align: middle;
    border-radius: 50%;
  }
  .brand-en {
    font-family: 'Arial Black', 'Trebuchet MS', sans-serif;
    font-size: 18pt;
    font-weight: 900;
    color: #d4af37;
    letter-spacing: 3px;
  }
  .brand-sub {
    font-size: 7pt;
    color: #d4af37;
    font-weight: bold;
  }
  .brand-ar {
    font-size: 18pt;
    font-weight: 900;
    color: #f5f0e8;
    text-align: left;
  }
  .brand-desc {
    font-size: 7.5pt;
    color: #d4af37;
    font-weight: bold;
    text-align: left;
  }

  /* Info Row */
  .info-label {
    font-size: 8pt;
    font-weight: bold;
    color: #5a4a3a;
  }
  .info-label-en {
    font-size: 6pt;
    color: #8a7a6a;
    font-weight: normal;
  }
  .info-value {
    font-size: 9.5pt;
    font-weight: bold;
    color: #2c2218;
  }

  /* Payment */
  .payment-title {
    font-size: 8pt;
    font-weight: bold;
    text-align: center;
    color: #2c2218;
  }
  .payment-title-en {
    font-size: 6pt;
    color: #8a7a6a;
  }
  .pay-opt {
    font-size: 8pt;
    font-weight: bold;
  }
  .pay-en {
    font-size: 6pt;
    color: #8a7a6a;
    font-family: 'Arial', sans-serif;
  }

  /* Customer */
  .cust-header {
    font-size: 10pt;
    font-weight: bold;
    color: #2c2218;
  }
  .cust-header-en {
    font-size: 7pt;
    color: #8a7a6a;
  }
  .cust-field {
    font-size: 8pt;
    font-weight: bold;
    color: #5a4a3a;
  }
  .cust-val {
    font-size: 8pt;
    font-weight: bold;
    color: #2c2218;
    border-bottom: 1px dotted #c0b8a8;
  }

  /* Product Table */
  .th-dark {
    background-color: #2c2218;
    color: #f5f0e8;
    font-size: 7pt;
    font-weight: bold;
    text-align: center;
    border-bottom: 2px solid #d4af37;
    padding: 5px 3px;
  }
  .th-en {
    font-size: 5.5pt;
    color: #d4af37;
    font-weight: normal;
    display: block;
  }
  .td-body {
    font-size: 8.5pt;
    font-weight: bold;
    text-align: center;
    color: #2c2218;
    border-bottom: 1px solid #e8e0d4;
    padding: 6px 3px;
  }
  .td-right {
    text-align: right;
  }
  .prod-en {
    font-size: 9pt;
    font-weight: bold;
    color: #1a1410;
    display: block;
  }
  .prod-ar {
    font-size: 7.5pt;
    font-weight: bold;
    color: #5a4a3a;
    display: block;
  }
  .prod-desc {
    font-size: 6.5pt;
    color: #8a7a6a;
    font-weight: normal;
    display: block;
  }
  .td-total {
    font-size: 9.5pt;
    font-weight: bold;
    text-align: center;
    color: #1a1410;
  }

  /* Totals */
  .total-label {
    font-size: 8pt;
    font-weight: bold;
    color: #5a4a3a;
  }
  .total-label-en {
    font-size: 6.5pt;
    color: #8a7a6a;
    font-weight: normal;
  }
  .total-val {
    font-size: 10pt;
    font-weight: bold;
    color: #2c2218;
    text-align: left;
  }
  .grand-bg {
    background-color: #2c2218;
    color: #f5f0e8;
  }
  .grand-label {
    font-size: 10pt;
    font-weight: bold;
    color: #f5f0e8;
  }
  .grand-label-en {
    font-size: 6.5pt;
    color: #d4af37;
    font-weight: normal;
  }
  .grand-val {
    font-size: 16pt;
    font-weight: bold;
    color: #f5f0e8;
    text-align: left;
  }
  .grand-cur {
    font-size: 9pt;
    color: #d4af37;
  }

  /* Remarks */
  .remarks-title {
    font-size: 9pt;
    font-weight: bold;
    color: #2c2218;
  }
  .remarks-en {
    font-size: 6.5pt;
    color: #8a7a6a;
    font-weight: normal;
  }
  .remarks-line {
    border-bottom: 1px dotted #d0c8b8;
    height: 14px;
  }

  /* Footer */
  .inv-footer {
    background-color: #1a1410;
    color: #d8d0c4;
    padding: 8px 14px;
    font-size: 7pt;
  }
  .footer-logo {
    width: 30px; height: 30px;
    background-color: #d4af37;
    color: #1a1410;
    font-size: 14pt;
    font-weight: bold;
    text-align: center;
    vertical-align: middle;
  }
  .footer-title {
    font-size: 7pt;
    font-weight: bold;
    color: #d4af37;
  }
  .footer-title-en {
    font-size: 5.5pt;
    color: #d8d0c4;
    font-weight: normal;
  }
  .footer-item {
    font-size: 6.5pt;
    color: #d8d0c4;
    font-weight: bold;
  }
  .thanks-text {
    font-size: 8pt;
    font-weight: bold;
    color: #d4af37;
    text-align: left;
  }
  .thanks-en {
    font-size: 6.5pt;
    color: #d8d0c4;
    font-weight: normal;
  }
  .tagline {
    font-size: 6.5pt;
    color: #8a7a6a;
    font-style: italic;
    text-align: left;
  }
</style>
</head>
<body>

<div class="Section1">

<!-- ====== HEADER ====== -->
<table class="inv-header" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td width="50%">
      <table cellpadding="0" cellspacing="0">
        <tr>
          <td class="logo-box" width="40" height="40">&nbsp;R</td>
          <td width="8"></td>
          <td>
            <span class="brand-en">ROVENTO</span><br>
            <span class="brand-sub">Premium Espresso Blends</span>
          </td>
        </tr>
      </table>
    </td>
    <td width="50%" align="left">
      <span class="brand-ar">روڤينتو</span><br>
      <span class="brand-desc">تليفقات حبوب إسبريسو فاخرة</span>
    </td>
  </tr>
</table>

<!-- ====== INFO ROW ====== -->
<table width="100%" cellpadding="6" cellspacing="0" border="1" bordercolor="#e0d8cc" style="border-collapse:collapse; background:#f8f4ed;">
  <tr>
    <!-- Invoice Info -->
    <td width="40%" valign="top">
      <table cellpadding="0" cellspacing="0">
        <tr><td class="info-label">رقم الفاتورة <span class="info-label-en">INVOICE NO.</span></td></tr>
        <tr><td class="info-value">INV-2026-0001</td></tr>
        <tr><td height="4"></td></tr>
        <tr><td class="info-label">التاريخ <span class="info-label-en">DATE</span></td></tr>
        <tr><td class="info-value">26 / 08 / 2026</td></tr>
        <tr><td height="4"></td></tr>
        <tr><td class="info-label">مندوب المبيعات <span class="info-label-en">SALES REP.</span></td></tr>
        <tr><td class="info-value" style="border-bottom:1px dotted #c0b8a8; min-width:120px;">&nbsp;</td></tr>
      </table>
    </td>

    <!-- QR -->
    <td width="20%" align="center" valign="top">
      <table cellpadding="0" cellspacing="0" align="center">
        <tr><td>
          <!-- QR Placeholder box -->
          <table width="50" height="50" cellpadding="0" cellspacing="0" border="2" bordercolor="#2c2218" style="background:white;">
            <tr>
              <td align="center" valign="middle" style="font-size:6pt; color:#8a7a6a; text-align:center;">
                <!-- Simulated QR pattern -->
                <table cellpadding="0" cellspacing="1" width="44" height="44" style="margin:auto;">
                  <tr>
                    <td width="14" height="14" bgcolor="#2c2218"></td>
                    <td width="2" height="14" bgcolor="white"></td>
                    <td width="12" height="14" bgcolor="#2c2218"></td>
                    <td width="2" height="14" bgcolor="white"></td>
                    <td width="14" height="14" bgcolor="#2c2218"></td>
                  </tr>
                  <tr>
                    <td width="14" height="4" bgcolor="white"></td>
                    <td width="2" height="4" bgcolor="white"></td>
                    <td width="12" height="4" bgcolor="white"></td>
                    <td width="2" height="4" bgcolor="white"></td>
                    <td width="14" height="4" bgcolor="white"></td>
                  </tr>
                  <tr>
                    <td width="14" height="14" bgcolor="#2c2218"></td>
                    <td width="2" height="14" bgcolor="white"></td>
                    <td width="12" height="14" bgcolor="#2c2218"></td>
                    <td width="2" height="14" bgcolor="white"></td>
                    <td width="14" height="14" bgcolor="#2c2218"></td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td></tr>
        <tr><td height="3"></td></tr>
        <tr><td style="font-size:5.5pt; color:#5a4a3a; text-align:center; line-height:1.3;">امسح الكود لمتابعة<br>حسابك على موقعنا</td></tr>
        <tr><td style="font-size:5pt; color:#8a7a6a; text-align:center;">www.rovento.site</td></tr>
      </table>
    </td>

    <!-- Payment -->
    <td width="40%" valign="top">
      <table width="100%" cellpadding="5" cellspacing="0" border="1" bordercolor="#e0d8cc" style="border-collapse:collapse; background:#fdfbf7;">
        <tr>
          <td class="payment-title" style="border-bottom:1px solid #e8e0d4; text-align:center;">
            طريقة الدفع<br><span class="payment-title-en">PAYMENT METHOD</span>
          </td>
        </tr>
        <tr>
          <td>
            <table cellpadding="2" cellspacing="0">
              <tr>
                <td width="14" style="border:1.5px solid #b89728; background:white;">&nbsp;</td>
                <td width="4"></td>
                <td class="pay-opt">نقدي<br><span class="pay-en">Cash</span></td>
              </tr>
              <tr><td height="3"></td></tr>
              <tr>
                <td width="14" style="border:1.5px solid #b89728; background:white;">&nbsp;</td>
                <td width="4"></td>
                <td class="pay-opt">تحويل بنكي<br><span class="pay-en">Bank Transfer</span></td>
              </tr>
              <tr><td height="3"></td></tr>
              <tr>
                <td width="14" style="border:1.5px solid #b89728; background:white;">&nbsp;</td>
                <td width="4"></td>
                <td class="pay-opt">فودافون كاش<br><span class="pay-en">Vodafone Cash</span></td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- ====== CUSTOMER DETAILS ====== -->
<table width="100%" cellpadding="7" cellspacing="0" border="1" bordercolor="#e0d8cc" style="border-collapse:collapse; background:#faf7f2;">
  <tr>
    <td colspan="2">
      <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td>
            <span class="cust-header">بيانات العميل</span><br>
            <span class="cust-header-en">CUSTOMER DETAILS</span>
          </td>
          <td align="left" style="color:#d4af37; font-size:14pt;">👤</td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td width="50%" class="cust-field">اسم العميل: <span class="cust-header-en">Customer Name:</span> <span class="cust-val">&nbsp;</span></td>
    <td width="50%" class="cust-field">رقم الهاتف: <span class="cust-header-en">Phone No.:</span> <span class="cust-val">&nbsp;</span></td>
  </tr>
  <tr>
    <td class="cust-field">العنوان: <span class="cust-header-en">Address:</span> <span class="cust-val">&nbsp;</span></td>
    <td class="cust-field">المحافظة: <span class="cust-header-en">Governorate:</span> <span class="cust-val">&nbsp;</span></td>
  </tr>
</table>

<!-- ====== PRODUCTS TABLE ====== -->
<table width="100%" cellpadding="0" cellspacing="0">
  <thead>
    <tr>
      <th class="th-dark" width="5%">#<span class="th-en">No.</span></th>
      <th class="th-dark td-right" width="27%">☕ المنتج<span class="th-en">PRODUCT</span></th>
      <th class="th-dark" width="10%">⚖️ الوزن<span class="th-en">WEIGHT</span></th>
      <th class="th-dark" width="8%">📦 الكمية<span class="th-en">QTY</span></th>
      <th class="th-dark" width="13%">💰 سعر الوحدة<span class="th-en">UNIT PRICE</span></th>
      <th class="th-dark" width="10%">🏷️ الخصم<span class="th-en">DISCOUNT</span></th>
      <th class="th-dark" width="12%">🛒 الإجمالي<span class="th-en">TOTAL</span></th>
      <th class="th-dark" width="8%">☕</th>
    </tr>
  </thead>
  <tbody>
    <!-- Product 1 -->
    <tr>
      <td class="td-body">1</td>
      <td class="td-body td-right">
        <span class="prod-en">Bar Intenso</span>
        <span class="prod-ar">بار إنتنسو</span>
        <span class="prod-desc">قهوة محمصة داكنة — قوة تركيز عالية</span>
      </td>
      <td class="td-body">1 كجم</td>
      <td class="td-body">5</td>
      <td class="td-body">450.00</td>
      <td class="td-body">0.00</td>
      <td class="td-total">2,250.00</td>
      <td class="td-body" style="font-size:14pt;">☕</td>
    </tr>
    <!-- Product 2 -->
    <tr style="background-color:rgba(212,175,55,0.04);">
      <td class="td-body">2</td>
      <td class="td-body td-right">
        <span class="prod-en">Premium</span>
        <span class="prod-ar">بريميوم</span>
        <span class="prod-desc">محمصة غامقة — نكهات عميقة وكريما غنية</span>
      </td>
      <td class="td-body">1 كجم</td>
      <td class="td-body">3</td>
      <td class="td-body">500.00</td>
      <td class="td-body">5%</td>
      <td class="td-total">1,425.00</td>
      <td class="td-body" style="font-size:14pt;">☕</td>
    </tr>
    <!-- Product 3 -->
    <tr>
      <td class="td-body">3</td>
      <td class="td-body td-right">
        <span class="prod-en">Classic</span>
        <span class="prod-ar">كلاسيك</span>
        <span class="prod-desc">محمصة متوسطة — طعم متوازن لطراز اليوم</span>
      </td>
      <td class="td-body">1 كجم</td>
      <td class="td-body">2</td>
      <td class="td-body">400.00</td>
      <td class="td-body">0%</td>
      <td class="td-total">800.00</td>
      <td class="td-body" style="font-size:14pt;">☕</td>
    </tr>
    <!-- Add more rows - edit in Word -->
    <tr>
      <td class="td-body">&nbsp;</td>
      <td class="td-body td-right"><span class="prod-en">&nbsp;</span></td>
      <td class="td-body">&nbsp;</td>
      <td class="td-body">&nbsp;</td>
      <td class="td-body">&nbsp;</td>
      <td class="td-body">&nbsp;</td>
      <td class="td-total">&nbsp;</td>
      <td class="td-body">&nbsp;</td>
    </tr>
  </tbody>
</table>

<!-- ====== BOTTOM: REMARKS + TOTALS ====== -->
<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <!-- Remarks -->
    <td width="48%" valign="top" style="border-left:1px solid #e0d8cc; padding:7px 14px;">
      <span class="remarks-title">📝 ملاحظات <span class="remarks-en">REMARKS</span></span>
      <table width="100%" cellpadding="5" cellspacing="0" border="1" bordercolor="#e8e0d4" style="border-collapse:collapse; background:#fdfbf7;">
        <tr><td class="remarks-line"></td></tr>
        <tr><td class="remarks-line"></td></tr>
        <tr><td class="remarks-line"></td></tr>
      </table>
    </td>

    <!-- Totals -->
    <td width="52%" valign="top" style="padding:7px 14px;">
      <table width="100%" cellpadding="3" cellspacing="0">
        <tr>
          <td class="total-label">إجمالي المنتجات<br><span class="total-label-en">Products Total</span></td>
          <td class="total-val">4,475.00</td>
        </tr>
        <tr>
          <td class="total-label">الخصم<br><span class="total-label-en">Discount</span></td>
          <td class="total-val">75.00</td>
        </tr>
        <tr>
          <td class="total-label">الشحن<br><span class="total-label-en">Shipping</span></td>
          <td class="total-val">50.00</td>
        </tr>
      </table>

      <!-- Grand Total -->
      <table width="100%" cellpadding="6" cellspacing="0" class="grand-bg" style="margin-top:5px; border-radius:4px;">
        <tr>
          <td class="grand-label">الإجمالي النهائي<br><span class="grand-label-en">Grand Total</span></td>
          <td align="left">
            <span class="grand-val">4,450</span>
            <span class="grand-cur">ج.م</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- ====== FOOTER ====== -->
<table width="100%" cellpadding="8" cellspacing="0" class="inv-footer">
  <tr>
    <!-- Logo -->
    <td width="7%">
      <div class="footer-logo">R</div>
    </td>

    <!-- Company Info -->
    <td width="30%">
      <span class="footer-title">🏢 بيانات الشركة <span class="footer-title-en">COMPANY INFO</span></span><br>
      <span class="footer-item">🌐 www.rovento.site</span><br>
      <span class="footer-item">✉️ info@rovento.site</span><br>
      <span class="footer-item">📞 01033012381 - 01042320848</span><br>
      <span class="footer-item">📍 مصر — المنصورة - Egypt</span>
    </td>

    <!-- Pricing Policy -->
    <td width="25%">
      <span class="footer-title">💰 سياسة الأسعار <span class="footer-title-en">PRICING POLICY</span></span><br>
      <span class="footer-item">
        قطاعي: من عبوة إلى 5 كيلو<br>
        نصف جملة: خصم 5%<br>
        جملة: خصم 10%
      </span>
    </td>

    <!-- Thank You -->
    <td width="38%" align="left">
      <span class="thanks-text">
        شكراً لاختياركم روفينتو<br>
        <span class="thanks-en">Thank you for choosing Rovento</span>
      </span><br>
      <span class="tagline">More than coffee... It's a lifestyle</span>
    </td>
  </tr>
</table>

</div>

</body>
</html>
